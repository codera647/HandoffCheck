{
  "name": "handoffcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Product and engineering feature handoffs with two-lead approval.",
  "author": "HandoffCheck contributors",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node --test desktop/tests/desktop.test.cjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:package": "npm run desktop:prepare && install-electron && electron-builder --win nsis --x64 --publish never --config electron-builder.json",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src shared tests e2e supabase/functions/handoff-api package.json vite.config.ts playwright.config.ts",
    "deploy:frontend": "npx --yes vercel@63.1.2 deploy --prod --scope codera647s-projects --non-interactive",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.149.0"
  }
}
